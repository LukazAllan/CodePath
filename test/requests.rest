############################################################
# AUTH
############################################################

### Signup
POST {{baseUrl}}{{auth}}/signup
Content-Type: {{contentType}}

{
  "name": "Allan Lucas",
  "email": "allan@codepath.com",
  "password": "123456"
}

###

### Login
POST {{baseUrl}}{{auth}}/login
Content-Type: {{contentType}}

{
  "email": "allan@codepath.com",
  "password": "123456"
}

###

### Me
### Devolve State
POST {{baseUrl}}{{auth}}/me
Content-Type: {{contentType}}

{
  "token": "{{token}}"
}


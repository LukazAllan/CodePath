############################################################
# QUESTIONS
############################################################

### Create Multiple Choice Question
POST {{baseUrl}}{{question}}
Content-Type: {{contentType}}

{
  "type": "MULTIPLE_CHOICE",
  "lesson": {
    "id": 1
  },
  "label": "Escolha a correta",
  "prompt": "O que é TypeScript?",
  "code": null,
  "options": [
    "Linguagem de banco de dados",
    "Superset do JavaScript",
    "Framework CSS",
    "Sistema operacional"
  ],
  "correct": 1,
  "hint": "Ele adiciona tipagem ao JS"
}

###

### Create True False Question
POST {{baseUrl}}{{question}}
Content-Type: {{contentType}}

{
  "type": "TRUE_FALSE",
  "lesson": {
    "id": 1
  },
  "label": "Verdadeiro ou falso",
  "prompt": "TypeScript compila para JavaScript",
  "correct": 0,
  "options": [
    "Verdadeiro",
    "Falso"
  ],
  "hint": "Ele vira JS no final"
}

###

### Create Matching Question
POST {{baseUrl}}{{question}}
Content-Type: {{contentType}}

{
  "type": "MATCHING",
  "lesson": {
    "id": 1
  },
  "label": "Associe",
  "prompt": "Associe os conceitos",
  "pairs": [
    {
      "left": "string",
      "right": "texto"
    },
    {
      "left": "number",
      "right": "número"
    }
  ],
  "hint": "Associe corretamente"
}

###

### Create Short Text Question
POST {{baseUrl}}{{question}}
Content-Type: {{contentType}}

{
  "type": "SHORT_TEXT",
  "lesson": {
    "id": 1
  },
  "label": "Resposta curta",
  "prompt": "Qual comando instala TypeScript globalmente?",
  "acceptedAnswers": [
    "npm install -g typescript",
    "npm i -g typescript"
  ],
